{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    // TypeScript 7 REMOVED baseUrl (TS5102) and no longer accepts non-relative
    // paths targets (TS5090). baseUrl was "." here, so the targets below are now
    // written relative to this file -- the same mapping, spelled the new way.
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./src/*"],
      "@types/*": ["./src/types/*"],
      "@utils/*": ["./src/utils/*"],
      "@validation/*": ["./src/validation/*"],
      "@modes/*": ["./src/modes/*"],
      "@session/*": ["./src/session/*"],
      "@cache/*": ["./src/cache/*"],
      "@export/*": ["./src/export/*"],
      "@taxonomy/*": ["./src/taxonomy/*"]
    },
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
