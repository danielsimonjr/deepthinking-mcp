{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ParetoThought",
  "type": "object",
  "required": [
    "mode",
    "items",
    "vitalFew"
  ],
  "properties": {
    "mode": {
      "const": "pareto"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "number"
          }
        },
        "additionalProperties": true
      }
    },
    "cumulativePercent": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "vitalFew": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendation": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
