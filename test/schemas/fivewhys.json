{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FiveWhysThought",
  "type": "object",
  "required": [
    "mode",
    "problem",
    "whys",
    "rootCause"
  ],
  "properties": {
    "mode": {
      "const": "fivewhys"
    },
    "problem": {
      "type": "string"
    },
    "whys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "question",
          "answer"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "rootCause": {
      "type": "string"
    },
    "correctiveAction": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
