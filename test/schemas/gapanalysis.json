{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GapAnalysisThought",
  "type": "object",
  "required": [
    "mode",
    "currentState",
    "desiredState",
    "gaps"
  ],
  "properties": {
    "mode": {
      "const": "gapanalysis"
    },
    "currentState": {
      "type": "string"
    },
    "desiredState": {
      "type": "string"
    },
    "gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "current",
          "desired",
          "gap",
          "action"
        ],
        "properties": {
          "dimension": {
            "type": "string"
          },
          "current": {
            "type": "string"
          },
          "desired": {
            "type": "string"
          },
          "gap": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "actionPlan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
